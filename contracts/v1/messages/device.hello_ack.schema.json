{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whale.example.internal/contracts/v1/messages/device.hello_ack.schema.json",
  "title": "device.hello_ack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "seq",
    "dir",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "协议版本 major.minor；未知 major 必须拒绝并回 error.protocol_version（§2）"
    },
    "id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z-]+$",
      "description": "消息 ID（ULID/UUID）"
    },
    "type": {
      "const": "device.hello_ack",
      "description": "消息类型"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800000,
      "description": "发送端发送时间（Unix 毫秒时间戳）"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "每方向各自单调递增序号，用于丢帧检测与乱序识别（§2）"
    },
    "dir": {
      "const": "downlink"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "server_time",
        "heartbeat_interval",
        "accepted_capabilities"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z-]+$",
          "description": "core 签发的本次控制通道会话 ID"
        },
        "server_time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800000,
          "description": "core 服务器当前时间（Unix 毫秒时间戳）"
        },
        "heartbeat_interval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "description": "心跳间隔（秒），协议基线 30s；90s 无心跳判定离线（§2）"
        },
        "accepted_capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "screen.context.read",
              "screen.history.search",
              "screen.evidence.read",
              "screen.live.subscribe",
              "phone.notification.post",
              "phone.notification.read",
              "phone.call.ring",
              "phone.call.audio",
              "phone.device.safe_action",
              "glasses.card.show",
              "glasses.card.update",
              "glasses.card.dismiss"
            ],
            "description": "能力名（§5）"
          },
          "description": "core 收窄后的能力集合，可为空数组"
        }
      },
      "description": "core 对 device.hello 的应答，可收窄能力"
    }
  }
}