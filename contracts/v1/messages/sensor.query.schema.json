{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whale.example.internal/contracts/v1/messages/sensor.query.schema.json",
  "title": "sensor.query",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "seq",
    "dir",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "协议版本 major.minor；未知 major 必须拒绝并回 error.protocol_version（§2）"
    },
    "id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z-]+$",
      "description": "消息 ID（ULID/UUID）"
    },
    "type": {
      "const": "sensor.query",
      "description": "消息类型"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800000,
      "description": "发送端发送时间（Unix 毫秒时间戳）"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "每方向各自单调递增序号，用于丢帧检测与乱序识别（§2）"
    },
    "dir": {
      "const": "downlink"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "operation",
        "filters",
        "max_items",
        "deadline"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z-]+$",
          "description": "请求 ID，sensor.result 按它关联"
        },
        "operation": {
          "type": "string",
          "enum": [
            "screen.context.read",
            "screen.history.search",
            "screen.evidence.read",
            "screen.live.subscribe",
            "phone.notification.post",
            "phone.notification.read",
            "phone.call.ring",
            "phone.call.audio",
            "phone.device.safe_action"
          ],
          "description": "查询操作对应的能力名（§5），core 先做权限检查，手机再按本地授权判断（§4）"
        },
        "filters": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": true,
          "description": "查询过滤条件（键值自由映射，由 operation 语义解释）"
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "返回条目上限"
        },
        "deadline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800000,
          "description": "请求截止时间；超时视为失败，对应 §2 请求类消息必须带超时（Unix 毫秒时间戳）"
        }
      },
      "description": "下行感知查询请求"
    }
  }
}
