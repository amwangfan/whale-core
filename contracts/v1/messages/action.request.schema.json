{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whale.example.internal/contracts/v1/messages/action.request.schema.json",
  "title": "action.request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "seq",
    "dir",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "协议版本 major.minor；未知 major 必须拒绝并回 error.protocol_version（§2）"
    },
    "id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z-]+$",
      "description": "消息 ID（ULID/UUID）"
    },
    "type": {
      "const": "action.request",
      "description": "消息类型"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800000,
      "description": "发送端发送时间（Unix 毫秒时间戳）"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "每方向各自单调递增序号，用于丢帧检测与乱序识别（§2）"
    },
    "dir": {
      "const": "downlink"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "capability",
        "args",
        "authorized_scope",
        "expires_at",
        "idempotency_key"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z-]+$",
          "description": "动作唯一 ID，action.receipt 按它关联"
        },
        "capability": {
          "type": "string",
          "enum": [
            "screen.context.read",
            "screen.history.search",
            "screen.evidence.read",
            "screen.live.subscribe",
            "phone.notification.post",
            "phone.notification.read",
            "phone.call.ring",
            "phone.call.audio",
            "phone.device.safe_action"
          ],
          "description": "请求调用的能力（§5），端侧校验白名单"
        },
        "args": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": true,
          "description": "动作参数（由 capability 语义解释）"
        },
        "authorized_scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "screen.context.read",
              "screen.history.search",
              "screen.evidence.read",
              "screen.live.subscribe",
              "phone.notification.post",
              "phone.notification.read",
              "phone.call.ring",
              "phone.call.audio",
              "phone.device.safe_action"
            ],
            "description": "能力名（§5）"
          },
          "description": "本次授权的能力上限集合，端侧校验 scope（§4）"
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "主人审批引用（可选；敏感动作要求审批，§3）"
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800000,
          "description": "动作过期时间；过期不补执行（§6）（Unix 毫秒时间戳）"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "description": "幂等键，端侧按它去重（§6）"
        }
      },
      "description": "下行动作请求；端侧校验白名单+有效期+scope"
    }
  }
}
