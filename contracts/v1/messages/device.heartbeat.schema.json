{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whale.example.internal/contracts/v1/messages/device.heartbeat.schema.json",
  "title": "device.heartbeat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "seq",
    "dir",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "协议版本 major.minor；未知 major 必须拒绝并回 error.protocol_version（§2）"
    },
    "id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z-]+$",
      "description": "消息 ID（ULID/UUID）"
    },
    "type": {
      "const": "device.heartbeat",
      "description": "消息类型"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800000,
      "description": "发送端发送时间（Unix 毫秒时间戳）"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "每方向各自单调递增序号，用于丢帧检测与乱序识别（§2）"
    },
    "dir": {
      "const": "uplink"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "observed_at",
        "status"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "设备 ID = Ed25519 公钥指纹 SHA-256 前 16 字节的小写 hex（32 字符，见 §3）"
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800000,
          "description": "端侧观察到该状态的时间（Unix 毫秒时间戳）"
        },
        "status": {
          "type": "string",
          "enum": [
            "online",
            "connected_only",
            "paused"
          ],
          "description": "online=在线可用 / connected_only=仅连接 / paused=功能暂停（§4）"
        },
        "battery": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "电量百分比（可选）"
        },
        "modules": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 64
          },
          "description": "模块名→模块状态串的自由映射（可选）"
        }
      },
      "description": "心跳，区分在线/仅连接/功能暂停"
    }
  }
}
