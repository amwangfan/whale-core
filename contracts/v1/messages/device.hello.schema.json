{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whale.example.internal/contracts/v1/messages/device.hello.schema.json",
  "title": "device.hello",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "seq",
    "dir",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "协议版本 major.minor；未知 major 必须拒绝并回 error.protocol_version（§2）"
    },
    "id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z-]+$",
      "description": "消息 ID（ULID/UUID）"
    },
    "type": {
      "const": "device.hello",
      "description": "消息类型"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800000,
      "description": "发送端发送时间（Unix 毫秒时间戳）"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "每方向各自单调递增序号，用于丢帧检测与乱序识别（§2）"
    },
    "dir": {
      "const": "uplink"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "device_id",
        "capabilities",
        "app_version",
        "signature",
        "challenge"
      ],
      "properties": {
        "protocol_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$",
          "description": "设备支持的协议版本 major.minor"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "设备 ID = Ed25519 公钥指纹 SHA-256 前 16 字节的小写 hex（32 字符，见 §3）"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "screen.context.read",
              "screen.history.search",
              "screen.evidence.read",
              "screen.live.subscribe",
              "phone.notification.post",
              "phone.notification.read",
              "phone.call.ring",
              "phone.call.audio",
              "phone.device.safe_action",
              "glasses.card.show",
              "glasses.card.update",
              "glasses.card.dismiss"
            ],
            "description": "能力名（§5）"
          },
          "description": "设备声明的能力集合，core 可在 hello_ack 中收窄"
        },
        "app_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "手机端应用版本号"
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$",
          "description": "对 challenge 的 Ed25519 签名（64 字节，小写 hex 编码，128 字符；编码格式协议未显式规定，此处定为 hex）"
        },
        "challenge": {
          "type": "string",
          "minLength": 16,
          "maxLength": 256,
          "description": "服务端在 WS 握手响应头/首帧下发的挑战串（§3）"
        }
      },
      "description": "设备认证握手（§3）；签名通过前连接仅接受本消息"
    }
  }
}