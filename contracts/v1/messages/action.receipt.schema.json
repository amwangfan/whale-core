{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whale.example.internal/contracts/v1/messages/action.receipt.schema.json",
  "title": "action.receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "seq",
    "dir",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "协议版本 major.minor；未知 major 必须拒绝并回 error.protocol_version（§2）"
    },
    "id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z-]+$",
      "description": "消息 ID（ULID/UUID）"
    },
    "type": {
      "const": "action.receipt",
      "description": "消息类型"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800000,
      "description": "发送端发送时间（Unix 毫秒时间戳）"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "每方向各自单调递增序号，用于丢帧检测与乱序识别（§2）"
    },
    "dir": {
      "const": "uplink"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "state"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z-]+$",
          "description": "对应 action.request 的 action_id"
        },
        "state": {
          "type": "string",
          "enum": [
            "received",
            "accepted",
            "executed",
            "failed",
            "unknown"
          ],
          "description": "received=已收到 / accepted=已接受 / executed=已执行 / failed=失败 / unknown=未知；「接受」≠「已执行」，禁止谎报（§4）"
        },
        "executed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800000,
          "description": "实际执行完成时间（state=executed/failed 时携带）（Unix 毫秒时间戳）"
        },
        "error_code": {
          "type": "string",
          "enum": [
            "protocol_version",
            "auth_failed",
            "device_revoked",
            "scope_denied",
            "capability_unknown",
            "expired",
            "duplicate",
            "rate_limited",
            "unavailable",
            "permission_missing",
            "invalid_message",
            "background_restricted",
            "internal",
            "timeout"
          ],
          "description": "失败时的错误码（state=failed 时携带）"
        },
        "provider_ref": {
          "type": "string",
          "maxLength": 128,
          "description": "可选：执行侧参考标记（如 foreground_verified/unverified、桥侧句柄）；诚实性注解，不构成执行证据"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string",
              "maxLength": 2000,
              "description": "执行结果摘要（有界，脱敏后）"
            },
            "output_ref": {
              "type": "string",
              "maxLength": 96,
              "description": "大输出的不透明引用（agent:out:<action_id>），经 device.agent.output.read 拉取"
            }
          },
          "description": "V1.1（core#58）：执行结果摘要/大输出引用；shell 输出/界面观察经此返回"
        }
      },
      "description": "动作回执"
    }
  }
}