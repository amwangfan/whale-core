{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whale.example.internal/contracts/v1/messages/sensor.result.schema.json",
  "title": "sensor.result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "seq",
    "dir",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "协议版本 major.minor；未知 major 必须拒绝并回 error.protocol_version（§2）"
    },
    "id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z-]+$",
      "description": "消息 ID（ULID/UUID）"
    },
    "type": {
      "const": "sensor.result",
      "description": "消息类型"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800000,
      "description": "发送端发送时间（Unix 毫秒时间戳）"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "每方向各自单调递增序号，用于丢帧检测与乱序识别（§2）"
    },
    "dir": {
      "const": "uplink"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "status",
        "data",
        "truncated",
        "source"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z-]+$",
          "description": "对应 sensor.query 的 request_id"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "denied",
            "unavailable",
            "paused",
            "error"
          ],
          "description": "查询结果状态（§4；paused=端侧一键暂停中，诚实不可用而非错误）"
        },
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "description": "结果条目数组；仅返回限定字段，不泄露本地路径（§4）；denied/error 时为空数组"
        },
        "truncated": {
          "type": "boolean",
          "description": "是否因 max_items 截断"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "数据来源标识（如 screenmemo.local）"
        }
      },
      "description": "上行感知查询结果"
    }
  }
}