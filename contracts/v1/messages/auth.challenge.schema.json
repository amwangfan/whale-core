{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whale.example.internal/contracts/v1/messages/auth.challenge.schema.json",
  "title": "auth.challenge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "seq",
    "dir",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "协议版本 major.minor；未知 major 必须拒绝并回 error.protocol_version（§2）"
    },
    "id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 64,
      "pattern": "^[0-9A-Za-z-]+$",
      "description": "消息 ID（ULID/UUID）"
    },
    "type": {
      "const": "auth.challenge",
      "description": "消息类型"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800000,
      "description": "发送端发送时间（Unix 毫秒时间戳）"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "每方向各自单调递增序号，用于丢帧检测与乱序识别（§2）"
    },
    "dir": {
      "const": "downlink"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge",
        "expires_in"
      ],
      "properties": {
        "challenge": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "32 字节随机挑战的小写 hex（64 字符）；device.hello 对该串的 UTF-8 字节做 Ed25519 签名（§3）"
        },
        "expires_in": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "description": "挑战有效期（秒）；超时未完成 device.hello 则关闭连接"
        }
      },
      "description": "服务端在 WS 连接建立后首帧下发的认证挑战（§3 补充消息）；签名通过前连接仅接受 device.hello"
    }
  },
  "description": "认证挑战首帧（§3 补充消息）"
}
