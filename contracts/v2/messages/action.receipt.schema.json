{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whale.example.internal/contracts/v2/messages/action.receipt.schema.json",
  "title": "action.receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "seq",
    "dir",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$",
      "description": "协议版本 major.minor；未知 major 必须拒绝并回 error.protocol_version（§2）"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "消息 ID（26 字符 ULID，§3）"
    },
    "type": {
      "const": "action.receipt",
      "description": "消息类型"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800000,
      "description": "发送端发送时间（Unix 毫秒）"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "每方向各自单调递增序号（§2）"
    },
    "dir": {
      "const": "uplink",
      "description": "uplink=机→云 / downlink=云→机"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "status"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^act_[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "对应 action.request 的 action_id"
        },
        "task_id": {
          "type": "string",
          "pattern": "^task_[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "所属任务（请求携带时回显）"
        },
        "status": {
          "type": "string",
          "description": "回执状态机（§7.2）；received 非终态，其余终态 first-wins",
          "enum": [
            "received",
            "succeeded",
            "failed",
            "timeout",
            "cancelled",
            "unknown"
          ]
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "description": "执行结果；大输出走 output_ref 引用，不落回执本体",
          "required": [
            "summary"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "description": "结果摘要",
              "maxLength": 2000
            },
            "output_ref": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*:[A-Za-z0-9._:/-]{1,128}$",
              "description": "不透明证据引用（§10），绝不泄露本地绝对路径"
            },
            "verification": {
              "type": "object",
              "additionalProperties": false,
              "description": "执行后验证（§7.3）；验证不了必须 skipped，禁止伪报 passed",
              "required": [
                "status",
                "summary"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "description": "验证状态",
                  "enum": [
                    "passed",
                    "failed",
                    "skipped"
                  ]
                },
                "summary": {
                  "type": "string",
                  "description": "验证说明",
                  "maxLength": 500
                }
              }
            }
          }
        },
        "error_code": {
          "type": "string",
          "enum": [
            "protocol_version",
            "auth_failed",
            "device_revoked",
            "scope_denied",
            "capability_unknown",
            "expired",
            "duplicate",
            "rate_limited",
            "unavailable",
            "permission_missing",
            "invalid_message",
            "internal",
            "background_restricted",
            "timeout",
            "cancelled",
            "stale_observation",
            "element_not_found",
            "approval_denied",
            "estop_active"
          ],
          "description": "失败/超时/取消时的错误码（§15 单一事实源）"
        },
        "provider_ref": {
          "type": "string",
          "description": "诚实性注解（如 corr:<event_id>、degraded:phone_notification）",
          "maxLength": 128
        },
        "started_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800000,
          "description": "执行开始时间（Unix 毫秒）"
        },
        "completed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800000,
          "description": "执行终结时间（Unix 毫秒）"
        }
      }
    }
  }
}
