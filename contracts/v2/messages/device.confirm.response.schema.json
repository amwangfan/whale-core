{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whale.example.internal/contracts/v2/messages/device.confirm.response.schema.json",
  "title": "device.confirm.response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "seq",
    "dir",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$",
      "description": "协议版本 major.minor；未知 major 必须拒绝并回 error.protocol_version（§2）"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "消息 ID（26 字符 ULID，§3）"
    },
    "type": {
      "const": "device.confirm.response",
      "description": "消息类型"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800000,
      "description": "发送端发送时间（Unix 毫秒）"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "每方向各自单调递增序号（§2）"
    },
    "dir": {
      "const": "uplink",
      "description": "uplink=机→云 / downlink=云→机"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_id",
        "approved",
        "responded_at"
      ],
      "properties": {
        "challenge_id": {
          "type": "string",
          "description": "对应挑战 ID",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "approved": {
          "type": "boolean",
          "description": "是否批准；拒绝/超时为 false"
        },
        "signature": {
          "type": "string",
          "description": "approved=true 时必填：Ed25519(challenge_id UTF-8 字节) 小写 hex",
          "pattern": "^[0-9a-f]{128}$"
        },
        "reason": {
          "type": "string",
          "description": "拒绝原因（可选）",
          "maxLength": 64
        },
        "responded_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800000,
          "description": "响应时间（Unix 毫秒）"
        }
      }
    }
  }
}
