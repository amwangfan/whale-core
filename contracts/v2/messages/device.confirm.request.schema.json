{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whale.example.internal/contracts/v2/messages/device.confirm.request.schema.json",
  "title": "device.confirm.request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "seq",
    "dir",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$",
      "description": "协议版本 major.minor；未知 major 必须拒绝并回 error.protocol_version（§2）"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "消息 ID（26 字符 ULID，§3）"
    },
    "type": {
      "const": "device.confirm.request",
      "description": "消息类型"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800000,
      "description": "发送端发送时间（Unix 毫秒）"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "每方向各自单调递增序号（§2）"
    },
    "dir": {
      "const": "downlink",
      "description": "uplink=机→云 / downlink=云→机"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_id",
        "device_id",
        "principal_id",
        "channel",
        "scopes",
        "expires_at"
      ],
      "properties": {
        "challenge_id": {
          "type": "string",
          "description": "挑战 ID（26 字符 ULID）",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "device_id": {
          "type": "string",
          "description": "目标设备 ID（§3，严格 32-hex）",
          "pattern": "^[0-9a-f]{32}$"
        },
        "principal_id": {
          "type": "string",
          "description": "请求确认的主体标识",
          "minLength": 1,
          "maxLength": 128
        },
        "channel": {
          "type": "string",
          "description": "发起通道（如 studio/qq/im）",
          "minLength": 1,
          "maxLength": 64
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "screen.context.read",
              "screen.history.search",
              "screen.evidence.read",
              "screen.live.subscribe",
              "phone.notification.post",
              "phone.notification.read",
              "phone.call.ring",
              "phone.call.audio",
              "phone.device.safe_action",
              "glasses.card.show",
              "glasses.card.update",
              "glasses.card.dismiss",
              "device.observe",
              "device.tap",
              "device.long_press",
              "device.swipe",
              "device.input_text",
              "device.key",
              "device.wait",
              "device.app.launch",
              "device.app.list",
              "device.app.install",
              "device.app.uninstall",
              "device.shell",
              "device.file.read",
              "device.file.write",
              "device.file.list",
              "device.logcat",
              "device.stop",
              "device.output.read",
              "device.screen.record",
              "device.status"
            ],
            "description": "能力名（§5.1 全协议唯一枚举）"
          },
          "description": "申请的能力范围",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800000,
          "description": "挑战过期时间（Unix 毫秒）"
        },
        "conversation_id": {
          "type": "string",
          "description": "关联会话（可选）",
          "maxLength": 128
        },
        "action_fingerprint": {
          "type": "string",
          "description": "待确认动作指纹（可选）",
          "maxLength": 128
        }
      }
    }
  }
}
