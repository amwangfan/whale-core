{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whale.example.internal/contracts/v2/messages/device.hello_ack.schema.json",
  "title": "device.hello_ack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "seq",
    "dir",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$",
      "description": "协议版本 major.minor；未知 major 必须拒绝并回 error.protocol_version（§2）"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "消息 ID（26 字符 ULID，§3）"
    },
    "type": {
      "const": "device.hello_ack",
      "description": "消息类型"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800000,
      "description": "发送端发送时间（Unix 毫秒）"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "每方向各自单调递增序号（§2）"
    },
    "dir": {
      "const": "downlink",
      "description": "uplink=机→云 / downlink=云→机"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "server_time",
        "heartbeat_interval",
        "accepted_capabilities"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "description": "会话 ID（26 字符 ULID）",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "server_time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800000,
          "description": "core 服务器时间（Unix 毫秒）"
        },
        "heartbeat_interval": {
          "type": "integer",
          "description": "心跳间隔（秒），基线 30",
          "minimum": 1,
          "maximum": 3600
        },
        "accepted_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "screen.context.read",
              "screen.history.search",
              "screen.evidence.read",
              "screen.live.subscribe",
              "phone.notification.post",
              "phone.notification.read",
              "phone.call.ring",
              "phone.call.audio",
              "phone.device.safe_action",
              "glasses.card.show",
              "glasses.card.update",
              "glasses.card.dismiss",
              "device.observe",
              "device.tap",
              "device.long_press",
              "device.swipe",
              "device.input_text",
              "device.key",
              "device.wait",
              "device.app.launch",
              "device.app.list",
              "device.app.install",
              "device.app.uninstall",
              "device.shell",
              "device.file.read",
              "device.file.write",
              "device.file.list",
              "device.logcat",
              "device.stop",
              "device.output.read",
              "device.screen.record",
              "device.status"
            ],
            "description": "能力名（§5.1 全协议唯一枚举）"
          },
          "description": "core 收窄后的能力集合（可为空数组）",
          "maxItems": 64,
          "uniqueItems": true
        }
      }
    }
  }
}
