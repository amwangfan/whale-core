{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whale.example.internal/contracts/v2/messages/recording.control.schema.json",
  "title": "recording.control",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "seq",
    "dir",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$",
      "description": "协议版本 major.minor；未知 major 必须拒绝并回 error.protocol_version（§2）"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "消息 ID（26 字符 ULID，§3）"
    },
    "type": {
      "const": "recording.control",
      "description": "消息类型"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800000,
      "description": "发送端发送时间（Unix 毫秒）"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "每方向各自单调递增序号（§2）"
    },
    "dir": {
      "const": "downlink",
      "description": "uplink=机→云 / downlink=云→机"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "op"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "关联 run"
        },
        "op": {
          "type": "string",
          "description": "录制操作",
          "enum": [
            "start",
            "pause",
            "resume",
            "stop"
          ]
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profile": {
              "type": "string",
              "description": "导出模板（phone_only / demo）",
              "maxLength": 32
            },
            "max_duration_ms": {
              "type": "integer",
              "description": "最长录制时长",
              "minimum": 1000,
              "maximum": 3600000
            },
            "exclude_packages": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "排除包名",
                "maxLength": 128
              },
              "description": "录制排除的应用",
              "maxItems": 32
            }
          }
        }
      }
    }
  }
}
