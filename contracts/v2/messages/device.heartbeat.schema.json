{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whale.example.internal/contracts/v2/messages/device.heartbeat.schema.json",
  "title": "device.heartbeat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "seq",
    "dir",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$",
      "description": "协议版本 major.minor；未知 major 必须拒绝并回 error.protocol_version（§2）"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "消息 ID（26 字符 ULID，§3）"
    },
    "type": {
      "const": "device.heartbeat",
      "description": "消息类型"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800000,
      "description": "发送端发送时间（Unix 毫秒）"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "每方向各自单调递增序号（§2）"
    },
    "dir": {
      "const": "uplink",
      "description": "uplink=机→云 / downlink=云→机"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "observed_at",
        "status"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "description": "设备 ID（§3）",
          "pattern": "^[0-9a-f]{32}$"
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800000,
          "description": "端侧观测时间（Unix 毫秒）"
        },
        "status": {
          "type": "string",
          "description": "在线状态",
          "enum": [
            "online",
            "connected_only",
            "paused"
          ]
        },
        "battery": {
          "type": "integer",
          "description": "电量百分比",
          "minimum": 0,
          "maximum": 100
        },
        "network": {
          "type": "string",
          "description": "网络类型",
          "enum": [
            "wifi",
            "cellular",
            "none",
            "unknown"
          ]
        },
        "modules": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 64
          },
          "description": "模块状态摘要（无内容数据）"
        }
      }
    }
  }
}
