{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whale.example.internal/contracts/v2/messages/error.schema.json",
  "title": "error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "seq",
    "dir",
    "payload"
  ],
  "properties": {
    "v": {
      "type": "string",
      "pattern": "^2\\.[0-9]+$",
      "description": "协议版本 major.minor；未知 major 必须拒绝并回 error.protocol_version（§2）"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "消息 ID（26 字符 ULID，§3）"
    },
    "type": {
      "const": "error",
      "description": "消息类型"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800000,
      "description": "发送端发送时间（Unix 毫秒）"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "每方向各自单调递增序号（§2）"
    },
    "dir": {
      "type": "string",
      "enum": [
        "uplink",
        "downlink"
      ],
      "description": "uplink=机→云 / downlink=云→机"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "code",
        "message"
      ],
      "properties": {
        "ref_id": {
          "type": "string",
          "description": "触发错误的消息 ID（26 字符 ULID）",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "code": {
          "type": "string",
          "enum": [
            "protocol_version",
            "auth_failed",
            "device_revoked",
            "scope_denied",
            "capability_unknown",
            "expired",
            "duplicate",
            "rate_limited",
            "unavailable",
            "permission_missing",
            "invalid_message",
            "internal",
            "background_restricted",
            "timeout",
            "cancelled",
            "stale_observation",
            "element_not_found",
            "approval_denied",
            "estop_active"
          ],
          "description": "错误码（§15 单一事实源）"
        },
        "message": {
          "type": "string",
          "description": "脱敏的人类可读错误描述，禁止含密钥/路径/隐私内容",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
