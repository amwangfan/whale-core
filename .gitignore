*.log
*.log.*
*.pid
*.pcm
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.state/
.tmp/
tmp/

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.iml

# ---------- local private notes ----------
LOCAL.md
NOTES.private.md

