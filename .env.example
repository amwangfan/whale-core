# Copy to .env for Docker, or export these variables before starting the CLI.
# No real credentials belong in Git. Web settings can configure the same providers.
# Initial profile is local. Configure any OpenAI-compatible endpoint in Settings.
# LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_MODEL_NAME=llama3.2
# LOCAL_MODEL_API_KEY=
# WHALE_API_TOKEN=replace-with-a-long-random-token
# WHALE_INTENT_MODEL_ENABLED=1
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# ASR_BASE_URL=https://api.openai.com/v1
# ASR_API_KEY=
# ASR_MODEL=whisper-1
# TTS_BASE_URL=https://api.openai.com/v1
# TTS_API_KEY=
# TTS_MODEL=tts-1
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-2
# VIDEO_PROTOCOL=dashscope
# VIDEO_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# VIDEO_MODEL=wan2.6-t2v
# VIDEO_API_KEY=
# CHANNEL_PROTOCOL=whale-io
# CHANNEL_BASE_URL=http://127.0.0.1:8091
# CHANNEL_API_KEY=
# CHANNEL_TARGET=explicit-owner-target

# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=18799
# BRIDGE_TOKEN=
# WHALE_VOICE_PUBLIC_URL=wss://your-host.example/realtime
# WHALE_DASHBOARD_URL=
# WHALE_DASHBOARD_TOKEN=
# WHALE_RING_URL=
# SIGNAL_TOKEN=
