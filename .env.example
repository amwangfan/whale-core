# Copy to .env for local Docker Compose; never commit actual credentials.
# The console can save model settings without environment variables.
# Ports are bound to localhost by default. Reverse proxy with TLS for remote use.
WHALE_PORT=8080
# WHALE_API_TOKEN=use-a-long-random-token-or-let-the-server-generate-one

# Cloud text model (select cloud in the console).
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Local model server: inside Docker, localhost is the container itself.
# Set a reachable host/LAN service URL in the console.
# LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_MODEL_NAME=

# Optional search (either provider enables search/fetch).
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# WHALE_INTENT_MODEL_ENABLED=1

# Optional controlled shell: requires non-root Linux + usable bwrap/prlimit.
# This explicitly permits free-form owner commands, still per-task approved.
WHALE_SHELL_ENABLED=0
WHALE_SHELL_TIER=managed

# Optional semantic retrieval (private summaries are sent to this endpoint).
WHALE_EMBEDDING_BASE_URL=
WHALE_EMBEDDING_API_KEY=
WHALE_EMBEDDING_MODEL=text-embedding-3-small
